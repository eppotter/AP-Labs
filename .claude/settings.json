{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/kit/hooks/session-start.sh\"; [ -f \"$f\" ] || exit 0; exec bash \"$f\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/kit/hooks/write-gate.sh\"; [ -f \"$f\" ] || exit 0; exec bash \"$f\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/kit/hooks/write-gate.sh\"; [ -f \"$f\" ] || exit 0; exec bash \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
