{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eppotter/AP-Labs/profiles/_schema/profile.schema.json",
  "title": "AP Labs client profile",
  "description": "Declares one client's inputs to the kit. Lives at .aplabs/profile.yml in the client repo; its presence marks the repo as governed. Unknown keys are errors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "client", "users"],
  "properties": {
    "schema_version": { "const": 1 },

    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "$ref": "#/$defs/text" }
      }
    },

    "tiers": {
      "description": "Blast radius (PR-01). Highest matching tier wins; unmatched code floors at T1.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "T3": { "$ref": "#/$defs/globs" },
        "T2": { "$ref": "#/$defs/globs" },
        "T1": { "$ref": "#/$defs/globs" }
      }
    },

    "inert": {
      "description": "Paths that floor at T0. A change is T0 only when every path is inert.",
      "$ref": "#/$defs/globs"
    },

    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exempt": { "description": "Paths the write gate never applies to.", "$ref": "#/$defs/globs" },
        "engagement_ttl_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 }
      }
    },

    "resources": {
      "description": "What can be granted. Keys are referenced by users[].grants and users[].deny.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label"],
        "properties": {
          "key": { "$ref": "#/$defs/resourceKey" },
          "label": { "$ref": "#/$defs/text" },
          "admin_grantable": {
            "description": "false = the admin role does not confer it; it needs an explicit grant.",
            "type": "boolean"
          },
          "open_access": {
            "description": "true = allowed for everyone, including people not in users. A user's deny still wins.",
            "type": "boolean"
          }
        }
      }
    },

    "users": {
      "description": "Who can do what (PR-03: deny beats allow). The only access source.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
          "name": { "$ref": "#/$defs/text" },
          "role": { "enum": ["admin", "member"] },
          "identities": {
            "description": "Per-surface ids, e.g. github, slack.",
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/slug" },
            "additionalProperties": { "$ref": "#/$defs/text" }
          },
          "grants": { "$ref": "#/$defs/resourceKeys" },
          "deny": { "$ref": "#/$defs/resourceKeys" }
        }
      }
    },

    "stages": {
      "description": "Add-on stages the client switches on. Each slots between two core stages and never removes one.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "addons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["dev_test", "dark_launch", "review_queue"] }
        }
      }
    },

    "sql": {
      "description": "Query guardrails (kit/runtime/sql).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forbidden_columns": {
          "description": "Columns no query may name, as lower-case \"table.column\". While any is set, wildcards and whole-row references are refused too. Default: none.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*$" }
        }
      }
    },

    "data": {
      "description": "Where the bot reads its data (kit/runtime/data). source: local (default; the built fixture file) or motherduck (the one MotherDuck database named by database, read with MOTHERDUCK_READ_TOKEN). database is required for motherduck and refused for local.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["local", "motherduck"] },
        "database": {
          "description": "A plain lower-case name, not MotherDuck's own my_db or sample_data and not a fixture:publish staging copy (*__publishing).",
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$",
          "not": {
            "anyOf": [
              { "type": "string", "enum": ["my_db", "sample_data"] },
              { "type": "string", "pattern": "__publishing$" }
            ]
          }
        }
      },
      "if": {
        "properties": { "source": { "const": "motherduck" } },
        "required": ["source"]
      },
      "then": { "properties": { "database": true }, "required": ["database"] },
      "else": { "properties": { "database": false } }
    },

    "verify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "run"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "run": {
                "description": "argv array, spawned without a shell. argv[0] is the executable.",
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/text" }
              },
              "timeout_seconds": {
                "description": "The check is killed and recorded as timeout after this long. Default 300.",
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              }
            }
          }
        },
        "env_allow": {
          "description": "Extra parent env var names passed to checks, on top of the fixed allowlist. Nothing else reaches a check.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
        }
      }
    }
  },

  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "globs": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/glob" } },
    "glob": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
    "resourceKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "resourceKeys": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/resourceKey" } }
  }
}
