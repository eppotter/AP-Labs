{
  "name": "ap-labs",
  "version": "0.0.0",
  "private": true,
  "description": "Governance kit for building AI agent solutions inside client organisations.",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#sdk": "./kit/runtime/sdk/index.js"
  },
  "aplabs": {
    "appDirs": [
      "examples/*/app"
    ]
  },
  "scripts": {
    "start": "node kit/runtime/app",
    "check": "bash scripts/check-syntax.sh && node scripts/check-conflict-markers.js && node scripts/check-write-path.js && node scripts/check-job-imports.js",
    "test": "node --test",
    "test:slow": "node scripts/run-slow-tests.js",
    "review": "node kit/review/cli.js",
    "retro": "node kit/retro/cli.js",
    "notify": "node kit/notify/cli.js",
    "verify": "node kit/verify/run-all.js",
    "engage": "node kit/hooks/engage.js",
    "land": "node kit/land/cli.js",
    "template:release": "node kit/release/release.js",
    "template:publish": "node kit/release/publish.js",
    "template:check": "node kit/release/check.js",
    "template:update": "node kit/release/update.js",
    "onboard": "node kit/onboard/cli.js",
    "fixture:generate": "node examples/brightside/fixture/generate.js",
    "fixture:check": "node examples/brightside/fixture/generate.js --check",
    "fixture:build": "node kit/fixture/build.js examples/brightside/fixture",
    "fixture:validate": "node kit/fixture/validate.js examples/brightside/fixture",
    "fixture:status": "node kit/fixture/status.js examples/brightside/fixture",
    "fixture:publish": "node kit/fixture/publish.js examples/brightside/fixture",
    "fixture:probe": "node kit/fixture/md-probe.js examples/brightside/fixture",
    "slack:manifest": "node kit/runtime/slack/manifest.js",
    "clean-bones": "bash scripts/clean-bones.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@duckdb/node-api": "1.5.6-r.2",
    "@slack/bolt": "5.1.0",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
