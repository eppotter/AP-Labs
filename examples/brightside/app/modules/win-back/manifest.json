{
  "id": "win-back",
  "hub": "brightside",
  "label": "Win-back list",
  "description": "Clients in one zone whose plan lapsed recently and who have no plan now, best win-back prospects first.",
  "resource": "WIN_BACK",
  "archetype": "scoped-pull",
  "environments": ["dev", "prod"],
  "parameters": [
    {
      "name": "zone",
      "label": "Zone",
      "type": "string",
      "description": "The client's home zone.",
      "enum": ["north", "south", "east", "west", "central"],
      "required": true
    },
    {
      "name": "lapsed_days",
      "label": "Lapsed within (days)",
      "type": "integer",
      "description": "A plan ended within this many days of the data's as-of date.",
      "min": 1,
      "max": 365,
      "default": 90,
      "required": true
    },
    {
      "name": "limit",
      "label": "How many clients",
      "type": "integer",
      "description": "The highest scores come first.",
      "min": 1,
      "max": 500,
      "default": 50,
      "required": true
    }
  ],
  "query": "win-back.sql",
  "row_id": "client_id",
  "scoring": {
    "inputs": [
      { "name": "months_as_client", "label": "Months as a client", "weight": 2, "min": 0, "max": 24 },
      { "name": "paid_dollars", "label": "Lifetime paid spend ($)", "weight": 3, "min": 0, "max": 10000 },
      { "name": "days_since_visit", "label": "Days since last completed visit", "weight": -1, "min": 0, "max": 120 },
      { "name": "plan_price_dollars", "label": "Lapsed plan price ($)", "weight": 1, "min": 100, "max": 300 },
      { "name": "price_rise", "label": "Price rise before lapse", "weight": 2, "min": 0, "max": 1 }
    ],
    "limit_parameter": "limit"
  }
}
