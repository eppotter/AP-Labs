{
  "display_information": {
    "name": "Brightside Bot (dev)",
    "description": "Brightside Home Cleaning's AP Labs runtime bot (template dev)."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Brightside Bot (dev)",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/brightside-v0",
        "description": "Open the Brightside v0 (blank) menu",
        "should_escape": false
      },
      {
        "command": "/brightside",
        "description": "Open the Brightside menu",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "im:write",
        "im:history",
        "files:read",
        "files:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.im",
        "team_join"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
